# Anchored to the repository root: the ignored directory is the top-level one
# holding downloaded structures. Unanchored, this pattern also swallowed
# msa_pairformer/data/, which is package source.
/data/
model_checkpoints/
__pycache__/
*.pyc
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
# Local virtualenv
.venv/

# Claude Code: share skills, keep machine-local state out
.claude/settings.local.json
.claude/worktrees/
